diff --git a/addon/utils/read-import-workbook.js b/addon/utils/read-import-workbook.js
new file mode 100644
index 0000000000000000000000000000000000000000..d2864cf217a596636104d6632aab877a54388eef
--- /dev/null
+++ b/addon/utils/read-import-workbook.js
@@ -0,0 +1,13 @@
+import * as XLSX from 'xlsx';
+
+/** Read only ordinary own worksheet entries at the untrusted file boundary. */
+export default function readImportWorkbook(buffer) {
+    const workbook = XLSX.read(buffer, { type: 'array' });
+    const names = workbook.SheetNames;
+    const sheets = workbook.Sheets;
+    const reserved = new Set(['__proto__', 'constructor', 'prototype']);
+    if (!Array.isArray(names) || names.length === 0 || !sheets || names.some((name) => typeof name !== 'string' || reserved.has(name) || !Object.prototype.hasOwnProperty.call(sheets, name))) {
+        throw new Error('Spreadsheet has an unsupported worksheet name. Rename the worksheet and try again.');
+    }
+    return workbook;
+}
