index 0000000000000000000000000000000000000000..001ed42442349f023bf8551deceb1d618cf15e0a
--- /dev/null
+++ b/lib/assert-safe-ast.js
@@ -0,0 +1,19 @@
+'use strict';
+
+// Defensive build-time bound for GHSA-vfj7-8cjw-p6xm, including caller-supplied ASTs.
+module.exports = ast => {
+  const pending = [[ast, 0]];
+  let visited = 0;
+  while (pending.length) {
+    const [node, depth] = pending.pop();
+    if (depth > 128 || ++visited > 65536) {
+      throw new RangeError('Brace pattern exceeds safe traversal limits');
+    }
+    if (node && Array.isArray(node.nodes)) {
+      for (const child of node.nodes) {
+        if (pending.length >= 65536) throw new RangeError('Brace pattern exceeds safe traversal limits');
+        pending.push([child, depth + 1]);
+      }
+    }
+  }
+};
