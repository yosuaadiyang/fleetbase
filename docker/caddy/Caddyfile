# Public entry point for production (docker-compose.prod.yml).
#
# Caddy obtains and renews Let's Encrypt certificates for both domains on its own;
# both must already resolve to this server, with ports 80 and 443 open.
#
#   CONSOLE_DOMAIN  the console (the Ember app)
#   API_DOMAIN      the API, plus the SocketCluster server under /socketcluster/
#
# The values come from the .env file next to docker-compose.yml, which
# scripts/docker-install.sh writes in production mode.

{
	email {$ACME_EMAIL}
}

(contrust_response_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

(contrust_console_headers) {
	import contrust_response_headers
	header {
		X-Frame-Options "SAMEORIGIN"
		Content-Security-Policy "frame-ancestors 'self'"
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; frame-src 'self' https://js.stripe.com https://hooks.stripe.com; object-src 'none'; base-uri 'self'"
		Permissions-Policy "geolocation=(self), camera=(self), microphone=(self)"
	}
}

{$CONSOLE_DOMAIN} {
	encode zstd gzip
	import contrust_console_headers
	reverse_proxy console:4200
}

{$API_DOMAIN} {
	# Contrust: administrative diagnostics are never public.
	@contrust_private_diagnostics path /opcache-api /opcache-api/*
	respond @contrust_private_diagnostics 404

	encode zstd gzip
	import contrust_response_headers

	# Real-time events. The console connects to wss://{$API_DOMAIN}/socketcluster/,
	# so the socket server needs no port or certificate of its own.
	@socket path /socketcluster/*
	reverse_proxy @socket socket:8000

	reverse_proxy httpd:80
}
