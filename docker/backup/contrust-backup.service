[Unit]
Description=Contrust encrypted offsite backup
After=docker.service network-online.target
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/contrust-backup
User=root
UMask=0077
Nice=15
IOSchedulingClass=idle
CPUQuota=25%
MemoryMax=384M
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
